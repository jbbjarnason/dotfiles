/* Solarized Dark Theme for Wofi */

/* Define Solarized Colors */
@base03: #002b36;
@base02: #073642;
@base01: #586e75;
@base00: #657b83;
@base0:  #839496;
@base1:  #93a1a1;
@base2:  #eee8d5;
@base3:  #fdf6e3;
@yellow: #b58900;
@orange: #cb4b16;
@red:    #dc322f;
@magenta:#d33682;
@violet: #6c71c4;
@blue:   #268bd2;
@cyan:   #2aa198;
@green:  #859900;

/* General Window Styling */
window {
    background-color: @base03;
    color: @base0;
    border: 1px solid @base02;
    border-radius: 5px;
    padding: 10px;
}

/* Entry (Input) Box */
entry {
    background-color: @base02;
    color: @base0;
    border: 1px solid @base01;
    padding: 5px;
    border-radius: 3px;
}

entry:active, entry:focus {
    background-color: @base02;
    border: 1px solid @blue;
}

/* List Items */
listview {
    background-color: @base03;
    color: @base0;
    border: none;
}

listview row {
    padding: 5px 10px;
}

listview row:selected {
    background-color: @blue;
    color: @base3;
}

listview row:hover {
    background-color: @base02;
    color: @base0;
}

/* Scrollbar */
scrollbar {
    background-color: @base02;
    color: @base0;
    border: none;
}

scrollbar slider {
    background-color: @base01;
    border-radius: 3px;
}

scrollbar slider:hover {
    background-color: @blue;
}

/* Button Styling (if any) */
button {
    background-color: @base02;
    color: @base0;
    border: 1px solid @base01;
    padding: 5px 10px;
    border-radius: 3px;
}

button:hover {
    background-color: @base01;
    color: @base3;
    border: 1px solid @blue;
}

/* Placeholder Text */
entry placeholder {
    color: @base01;
}

