(defpoll notes_text :interval "1s" :initial "loading..."
  "cat $HOME/.local/share/notes/board.md")

(defwindow notes
  :monitor 0                      ; 
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%")
  :stacking "bottom"              ; behind normal app windows
  :exclusive false
  :focusable false
  (box :class "desknotes"
       (scroll :vscroll true
         (label :wrap true :text {notes_text}))))

